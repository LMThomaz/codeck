{
  // ▶ "Commitdeck (dev)": sobe o backend em depuração (porta 47822, dados em data-sandbox/) e abre o app nativo
  // conectado nele — sem tocar no app instalado nem nas suas contas reais. O Commitdeck só roda como app de desktop.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (depurar)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/server.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "COMMITDECK_PORT": "47822",
        "COMMITDECK_DATA": "${workspaceFolder}/data-sandbox",
        "COMMITDECK_NATIVE_NOTIFY": "1"
      }
    },
    {
      "name": "App macOS (conecta no backend em depuração)",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "Compilar app macOS",
      "command": "COMMITDECK_ATTACH=1 COMMITDECK_PORT=47822 \"${workspaceFolder}/dist/Commitdeck.app/Contents/MacOS/Commitdeck\""
    },
    {
      "name": "App Windows (conecta no backend em depuração)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Compilar app Windows",
      "program": "${workspaceFolder}/windows/Commitdeck/bin/Debug/net8.0-windows/win-x64/Commitdeck.exe",
      "cwd": "${workspaceFolder}",
      "env": { "COMMITDECK_ATTACH": "1", "COMMITDECK_PORT": "47822" }
    },
    {
      "name": "Instalar o app no meu Mac",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash scripts/build-macos.sh"
    }
  ],
  "compounds": [
    { "name": "Commitdeck (dev, macOS)", "configurations": ["Backend (depurar)", "App macOS (conecta no backend em depuração)"], "stopAll": true },
    { "name": "Commitdeck (dev, Windows)", "configurations": ["Backend (depurar)", "App Windows (conecta no backend em depuração)"], "stopAll": true }
  ]
}
